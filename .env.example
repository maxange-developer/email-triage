# Mock mode flags (recommended for local demo: keep all true)
USE_MOCK_AUTH=true
USE_MOCK_AI=true
USE_MOCK_DATA=true
NEXT_PUBLIC_USE_MOCK=true

# NextAuth — required even in mock mode
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI — only required if USE_MOCK_AI=false (real classification + reply generation)
OPENAI_API_KEY=

# Google OAuth — only required if USE_MOCK_AUTH=false (real Gmail sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Vercel Cron — only required if cron jobs are enabled in vercel.json
CRON_SECRET=
